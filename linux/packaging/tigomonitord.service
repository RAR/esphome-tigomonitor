[Unit]
Description=Tigo optimizer monitor
Documentation=https://github.com/RAR/esphome-tigomonitor
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/tigomonitord
# The web UI's "Restart service" exits cleanly and relies on this.
Restart=always
RestartSec=3

# No fixed account: systemd makes one per run. dialout reads the RS485
# adapter, bluetooth lets BlueZ take its calls for the CCA page, and the
# capability lets it serve the web UI on port 80.
DynamicUser=yes
SupplementaryGroups=dialout bluetooth
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=tigomonitor

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
