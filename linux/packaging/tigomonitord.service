[Unit]
Description=Tigo optimizer monitor
Documentation=https://github.com/RAR/esphome-tigomonitor
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/tigomonitord
# The web UI's "Restart service" exits cleanly and relies on this.
Restart=always
RestartSec=3
# The main loop checks in every second; one that stops for a minute is
# restarted, rather than left running and publishing nothing. As bus master
# that loop also polls the bus: a hang lets the lease lapse, so the array
# goes safe, and the restart brings the master back.
WatchdogSec=60

# As bus master the daemon must answer the TAP on time, and on a Pi Zero
# the daily apt list refresh stalled it for 1.1 s. Ahead of other work for
# the CPU and the SD card; its own disk writes are a few KB a minute.
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=4

# A system account the package creates, in dialout (the RS485 adapter) and
# bluetooth (the CCA page); the capability serves the web UI on port 80.
# Not DynamicUser: D-Bus cannot resolve those accounts unless nss-systemd is
# configured, which Raspberry Pi OS does not do, and drops their connection,
# so the CCA page could never reach BlueZ.
User=tigomonitor
Group=tigomonitor
SupplementaryGroups=dialout bluetooth
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=tigomonitor

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
